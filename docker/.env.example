# ============================================================
# Scalable AI Production Infrastructure — Environment Config
# Copy to .env and fill in real values. NEVER commit .env!
# ============================================================

# --- General ---
COMPOSE_PROJECT_NAME=scalable-ai-infra
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=UTC

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scalable_ai
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB

# --- MongoDB ---
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=scalable_ai_docs
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_mongo_password
MONGO_APP_USER=app_user
MONGO_APP_PASSWORD=CHANGE_ME_mongo_app_password

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_MAX_MEMORY=512mb
REDIS_DB=0

# --- API Service ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# --- Auth Service ---
AUTH_HOST=0.0.0.0
AUTH_PORT=8001
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_minimum_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Worker Service ---
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2
CELERY_CONCURRENCY=4
CELERY_TASK_TIMEOUT=300

# --- Inference Service ---
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8002
INFERENCE_DEVICE=cpu
INFERENCE_MAX_BATCH_SIZE=32
INFERENCE_MODEL_PATH=/app/models
INFERENCE_TIMEOUT=60

# --- Nginx Gateway ---
NGINX_PORT=80
NGINX_SSL_PORT=443
RATE_LIMIT=10r/s

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
LOKI_PORT=3100

# --- Docker Image Tags ---
API_IMAGE_TAG=latest
AUTH_IMAGE_TAG=latest
WORKER_IMAGE_TAG=latest
INFERENCE_IMAGE_TAG=latest
